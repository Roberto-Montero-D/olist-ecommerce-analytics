digraph G {graph[bgcolor=white,pad=0.3,nodesep=0.5,ranksep=0.65,fontname=Arial,splines=ortho];node[shape=box,style="rounded,filled",fontname=Arial,margin="0.16,0.12",width=2.4];edge[fontname=Arial,color="#64748B",arrowsize=0.65];label="Olist Warehouse Build & Validation Pipeline";labelloc=t;fontsize=20;
a[fillcolor="#F1F5F9",label="00 — Validate Design\nModel assumptions"];b[fillcolor="#DBEAFE",label="01 — Create Schema\nDimensions • facts\nconstraints • indexes"];c[fillcolor="#DCFCE7",label="02 — Load Dimensions\nConformed dimensions\ncanonical geography"];d[fillcolor="#FEF3C7",label="02b — Validate Dimensions\nPost-load checks"];e[fillcolor="#EDE9FE",label="03 — Load Facts\nResolve surrogate keys\npreserve natural grains"];f[fillcolor="#FCE7F3",label="04 — Validate Warehouse\nReconciliation\nanalytical validation"];
