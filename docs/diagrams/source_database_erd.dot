digraph G {graph [bgcolor="white",pad="0.3",nodesep="0.45",ranksep="0.6",fontname="Arial",splines=ortho]; node [fontname="Arial"]; edge [fontname="Arial",fontsize=8,color="#64748B",arrowsize=0.65];
rankdir=LR; label="Olist Source Database ERD — PostgreSQL schema: olist"; labelloc=t; fontsize=20;
node [shape=plain];
customers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#E2E8F0"><B>customers</B></TD></TR><TR><TD><B>PK</B></TD><TD ALIGN="LEFT">customer_id</TD></TR><TR><TD></TD><TD ALIGN="LEFT">customer_unique_id</TD></TR><TR><TD></TD><TD ALIGN="LEFT">customer_zip_code_prefix</TD></TR><TR><TD></TD><TD ALIGN="LEFT">customer_city / customer_state</TD></TR></TABLE>>];
orders [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#DBEAFE"><B>orders</B></TD></TR><TR><TD><B>PK</B></TD><TD ALIGN="LEFT">order_id</TD></TR><TR><TD><B>FK</B></TD><TD ALIGN="LEFT">customer_id</TD></TR><TR><TD></TD><TD ALIGN="LEFT">order_status</TD></TR><TR><TD></TD><TD ALIGN="LEFT">purchase / approval timestamps</TD></TR><TR><TD></TD><TD ALIGN="LEFT">carrier / delivery timestamps</TD></TR><TR><TD></TD><TD ALIGN="LEFT">estimated_delivery_date</TD></TR></TABLE>>];
items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#DCFCE7"><B>order_items</B></TD></TR><TR><TD><B>PK, FK</B></TD><TD ALIGN="LEFT">order_id</TD></TR><TR><TD><B>PK</B></TD><TD ALIGN="LEFT">order_item_id</TD></TR><TR><TD><B>FK</B></TD><TD ALIGN="LEFT">product_id</TD></TR><TR><TD><B>FK</B></TD><TD ALIGN="LEFT">seller_id</TD></TR><TR><TD></TD><TD ALIGN="LEFT">shipping_limit_date</TD></TR><TR><TD></TD><TD ALIGN="LEFT">price / freight_value</TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#FEF3C7"><B>order_payments</B></TD></TR><TR><TD><B>PK, FK</B></TD><TD ALIGN="LEFT">order_id</TD></TR><TR><TD><B>PK</B></TD><TD ALIGN="LEFT">payment_sequential</TD></TR><TR><TD></TD><TD ALIGN="LEFT">payment_type / installments / value</TD></TR></TABLE>>];
reviews [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#FCE7F3"><B>order_reviews</B></TD></TR><TR><TD><B>PK</B></TD><TD ALIGN="LEFT">review_id</TD></TR><TR><TD><B>PK, FK</B></TD><TD ALIGN="LEFT">order_id</TD></TR><TR><TD></TD><TD ALIGN="LEFT">review_score (1–5)</TD></TR><TR><TD></TD><TD ALIGN="LEFT">title / message</TD></TR><TR><TD></TD><TD ALIGN="LEFT">creation / answer timestamps</TD></TR></TABLE>>];
products [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#EDE9FE"><B>products</B></TD></TR><TR><TD><B>PK</B></TD><TD ALIGN="LEFT">product_id</TD></TR><TR><TD></TD><TD ALIGN="LEFT">product_category_name</TD></TR><TR><TD></TD><TD ALIGN="LEFT">name / description length</TD></TR><TR><TD></TD><TD ALIGN="LEFT">photos / weight / dimensions</TD></TR></TABLE>>];
sellers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#CCFBF1"><B>sellers</B></TD></TR><TR><TD><B>PK</B></TD><TD ALIGN="LEFT">seller_id</TD></TR><TR><TD></TD><TD ALIGN="LEFT">seller_zip_code_prefix</TD></TR><TR><TD></TD><TD ALIGN="LEFT">seller_city / seller_state</TD></TR></TABLE>>];
translation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#F1F5F9"><B>category_translation</B></TD></TR><TR><TD><B>PK</B></TD><TD ALIGN="LEFT">product_category_name</TD></TR><TR><TD></TD><TD ALIGN="LEFT">product_category_name_english</TD></TR></TABLE>>];
geo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="5"><TR><TD BGCOLOR="#F1F5F9"><B>geolocation</B></TD></TR><TR><TD>geolocation_zip_code_prefix</TD></TR><TR><TD>latitude / longitude</TD></TR><TR><TD>city / state</TD></TR><TR><TD><I>No PK — multiple observations per CEP</I></TD></TR></TABLE>>];
customers->orders[label="1 : N"]; orders->items[label="1 : N"]; orders->payments[label="1 : N"]; orders->reviews[label="1 : N"]; products->items[label="1 : N"]; sellers->items[label="1 : N"];
edge[style=dashed,color="#94A3B8",arrowhead=none]; products->translation[label="logical category mapping"]; customers->geo[label="logical CEP lookup"]; sellers->geo[label="logical CEP lookup"];
legend[shape=note,style=filled,fillcolor="#F8FAFC",label="Solid arrow = enforced FK\nDashed line = logical / non-enforced"];
}